{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/enable_githooks.py",
            "statusMessage": "Enabling the repo's pre-commit check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guard_git.py"
          }
        ]
      }
    ]
  }
}
